# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash   # smarter, but only ~20 requests/day on the free tier
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Free tier is rate-limited (~10 requests/min). Remove or raise on a paid key.
GEMINI_RPM=10

# GitHub MCP server (optional) — a personal access token from https://github.com/settings/tokens
GITHUB_TOKEN=

# Qdrant (only if vector_store.provider: qdrant in config.yaml)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Web UI (repomind-web)
# ALLOW_SHELL=false          # true gives the web agent run_command (each call still needs approval)
# APP_ACCESS_TOKEN=          # set to require a password for the web UI / API
